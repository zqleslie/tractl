schemaVersion: 1
capabilities:
  - protocol.http

metadata:
  name: hooks-deterministic-apis
  description: "tractl.now(), tractl.random(), tractl.log(), and ctx.* — the full deterministic API surface."

variables:
  baseUrl: "https://jsonplaceholder.typicode.com"
  region: "us-east-1"

workflows:
  - id: hooks-deterministic-apis-flow
    variables:
      env: "staging"

    hooks:
      beforeAll:
        language: js
        source: |
          var region  = ctx.spec["region"]  || "unknown";
          var env     = ctx.workflow["env"] || "unknown";
          var ts      = tractl.now();
          var traceId = "tid-" + Math.floor(tractl.random() * 0xFFFFFF).toString(16);
          tractl.log("region=" + region + " env=" + env + " ts=" + ts);
          return {
            variables: {
              "computed-trace-id": traceId,
              "computed-ts":       String(ts)
            }
          };

      afterAll:
        language: js
        source: |
          var traceId = ctx.workflow["computed-trace-id"] || "(not set)";
          tractl.log("completed, trace=" + traceId);
          return {};

    steps:
      - id: fetch-todo
        kind: request
        request:
          protocol: http
          target: "${vars.baseUrl}/todos/1"
          operation: GET
        assertions:
          - id: status-ok
            kind: status
            op: equals
            expected: 200

      - id: fetch-user
        kind: request
        dependsOn:
          - fetch-todo
        request:
          protocol: http
          target: "${vars.baseUrl}/users/1"
          operation: GET
        assertions:
          - id: user-status
            kind: status
            op: equals
            expected: 200
        hooks:
          afterStep:
            language: js
            source: |
              var elapsed = tractl.now();
              tractl.log("afterStep: elapsed-token=" + elapsed);
              return { variables: { "last-step-ts": String(elapsed) } };
