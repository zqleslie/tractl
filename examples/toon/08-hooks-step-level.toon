schemaVersion: 1
capabilities:
  - protocol.http

metadata:
  name: hooks-step-level
  description: "beforeStep / afterStep / transform are scoped to one step. transform promotes response data into variables."

variables:
  baseUrl: "https://jsonplaceholder.typicode.com"

workflows:
  - id: hooks-step-level-flow
    steps:
      - id: fetch-comment
        kind: request
        request:
          protocol: http
          target: "${vars.baseUrl}/comments/1"
          operation: GET
        assertions:
          - id: comment-status
            kind: status
            op: equals
            expected: 200
        hooks:
          beforeStep:
            language: js
            source: |
              tractl.log("beforeStep(fetch-comment)");
              return {};

          afterStep:
            language: js
            source: |
              tractl.log("afterStep(fetch-comment)");
              return {};

          transform:
            language: js
            source: |
              tractl.log("transform(fetch-comment): promoting postId");
              return { variables: { "comment-post-id": "1" } };

      - id: fetch-related-post
        kind: request
        dependsOn:
          - fetch-comment
        request:
          protocol: http
          target: "${vars.baseUrl}/posts/1"
          operation: GET
        assertions:
          - id: post-status
            kind: status
            op: equals
            expected: 200
